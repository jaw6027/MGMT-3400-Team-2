{
  "name": "lancaster-vending-scout",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "PORT=${PORT:-3001} node --use-env-proxy server/index.js",
    "build": "vite build",
    "start": "node --use-env-proxy server.js",
    "test": "node --test test/*.test.js tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "start:vendwell": "NODE_ENV=production PORT=${PORT:-3001} node --use-env-proxy server/index.js",
    "start:scout": "PORT=${PORT:-3002} node --use-env-proxy server.js",
    "start:inventory": "python3 app.py --port 3000",
    "test:inventory": "python3 -m unittest discover -s tests -v"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.1"
  }
}
