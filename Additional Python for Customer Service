import io
import sqlite3
from datetime import datetime
from enum import Enum
from typing import List, Optional

import qrcode
from fastapi import FastAPI, HTTPException, Query
from fastapi.responses import HTMLResponse, StreamingResponse
from pydantic import BaseModel

app = FastAPI(title="Vending Machine Customer Service System")
DB_NAME = "vending_support.db"

# --- ENUMS FOR VALIDATION ---
class RequestType(str, Enum):
    FEEDBACK = "feedback"
    PRODUCT_REQUEST = "product_request"
    STUCK_ITEM_REFUND = "stuck_item_refund"

class TicketStatus(str, Enum):
    RECEIVED = "received"
    IN_PROGRESS = "in_progress"
    CLOSED = "closed"

# --- PYDANTIC MODELS ---
class TicketCreate(BaseModel):
    machine_id: str
    request_type: RequestType
    customer_contact: Optional[str] = None
    item_code_or_name: Optional[str] = None
    details: str

class TicketUpdate(BaseModel):
    status: TicketStatus
    operator_notes: Optional[str] = None

class TicketResponse(BaseModel):
    id: int
    machine_id: str
    request_type: str
    customer_contact: Optional[str]
    item_code_or_name: Optional[str]
    details: str
    status: str
    operator_notes: Optional[str]
    created_at: str
    updated_at: str

# --- DATABASE SETUP ---
def init_db():
    with sqlite3.connect(DB_NAME) as conn:
        cursor = conn.cursor()
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS tickets (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                machine_id TEXT NOT NULL,
                request_type TEXT NOT NULL,
                customer_contact TEXT,
                item_code_or_name TEXT,
                details TEXT NOT NULL,
                status TEXT NOT NULL,
                operator_notes TEXT,
                created_at TEXT NOT NULL,
                updated_at TEXT NOT NULL
            )
        """)
        conn.commit()

init_db()

