                </div>

                <label for="details">Details</label>
                <textarea id="details" rows="3" placeholder="Tell us what happened..." required></textarea>

                <button type="submit">Submit Request</button>
            </form>

            <div id="successBox" class="success-box">
                <strong>Request Received!</strong><br>
                Ticket #<span id="ticketId"></span> has been logged.<br>
                Status: <b>RECEIVED</b>
            </div>
        </div>

        <script>
            function toggleFields() {{
                const type = document.getElementById('request_type').value;
                const itemLabel = document.getElementById('item_label');
                const contactLabel = document.getElementById('contact_label');
                
                if (type === 'stuck_item_refund') {{
                    itemLabel.innerText = "Slot Number or Stuck Item *";
                    contactLabel.innerText = "Phone or Email for Refund *";
                }} else if (type === 'product_request') {{
                    itemLabel.innerText = "Desired Product Name *";
                    contactLabel.innerText = "Email/Phone (Optional - to notify when stocked)";
                }} else {{
                    itemLabel.innerText = "Item Name (Optional)";
                    contactLabel.innerText = "Email/Phone (Optional)";
