import io
import sqlite3
from datetime import datetime
from enum import Enum
from typing import List, Optional

import qrcode
from fastapi import FastAPI, HTTPException, Query
from fastapi.responses import StreamingResponse
from pydantic import BaseModel

app = FastAPI(title="Vending Machine Customer Service API")
DB_NAME = "vending_support.db"

# --- ENUMS FOR VALIDATION ---
class RequestType(str, Enum):
    FEEDBACK = "feedback"
    PRODUCT_REQUEST = "product_request"
    STUCK_ITEM_REFUND = "stuck_item_refund"

class TicketStatus(str, Enum):
    RECEIVED = "received"       # Automatically set upon submission
    IN_PROGRESS = "in_progress" # Operator is reviewing/refunding
    CLOSED = "closed"           # Operator resolved the issue

# --- PYDANTIC MODELS ---
class TicketCreate(BaseModel):
    machine_id: str
    request_type: RequestType
    customer_contact: Optional[str] = None  # Email or phone for refunds/updates
    item_code_or_name: Optional[str] = None # E.g., "A4" or "Doritos"
    details: str

class TicketUpdate(BaseModel):
    status: TicketStatus
    operator_notes: Optional[str] = None

class TicketResponse(BaseModel):
    id: int
    machine_id: str
    request_type: str
    customer_contact: Optional[str]
    item_code_or_name: Optional[str]
    details: str
    status: str
    operator_notes: Optional[str]
    created_at: str
    updated_at: str

# --- DATABASE SETUP ---
def init_db():
    with sqlite3.connect(DB_NAME) as conn:
        cursor = conn.cursor()
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS tickets (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                machine_id TEXT NOT NULL,
                request_type TEXT NOT NULL,
                customer_contact TEXT,
                item_code_or_name TEXT,
                details TEXT NOT NULL,
                status TEXT NOT NULL,
                operator_notes TEXT,
                created_at TEXT NOT NULL,
                updated_at TEXT NOT NULL
            )
        """)
        conn.commit()

init_db()

# --- 1. QR CODE GENERATOR ENDPOINT ---
@app.get("/machines/{machine_id}/qr")
def generate_machine_qr(
    machine_id: str, 
    base_url: str = Query("http://localhost:8000", description="Your hosted domain URL")
):
    """
    Generates a QR code image for a specific vending machine.
    Scanning it directs the customer to a URL pre-loaded with the machine_id.
    """
    # URL the customer's phone will open when scanning the sticker on the machine
    support_url = f"{base_url}/support?machine_id={machine_id}"
    
    qr = qrcode.QRCode(version=1, box_size=10, border=4)
    qr.add_data(support_url)
    qr.make(fit=True)
    
    img = qr.make_image(fill_color="black", back_color="white")
    buf = io.BytesIO()
    img.save(buf, format="PNG")
    buf.seek(0)
    
    return StreamingResponse(buf, media_type="image/png")

# --- 2. CUSTOMER SUBMISSION ENDPOINT ---
@app.post("/tickets/", response_model=TicketResponse)
def submit_ticket(ticket: TicketCreate):
    """
    Accepts customer feedback, product requests, or stuck-item refund claims.
    Automatically sets initial status to 'received'.
    """
    now = datetime.utcnow().isoformat()
    initial_status = TicketStatus.RECEIVED.value

    with sqlite3.connect(DB_NAME) as conn:
        cursor = conn.cursor()
        cursor.execute("""
            INSERT INTO tickets (
                machine_id, request_type, customer_contact, 
                item_code_or_name, details, status, created_at, updated_at
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            ticket.machine_id,
            ticket.request_type.value,
            ticket.customer_contact,
            ticket.item_code_or_name,
            ticket.details,
            initial_status,
            now,
            now
        ))
        ticket_id = cursor.lastrowid
        conn.commit()

    return TicketResponse(
        id=ticket_id,
        machine_id=ticket.machine_id,
        request_type=ticket.request_type.value,
        customer_contact=ticket.customer_contact,
        item_code_or_name=ticket.item_code_or_name,
        details=ticket.details,
        status=initial_status,
        operator_notes=None,
        created_at=now,
        updated_at=now
    )

# --- 3. OPERATOR VIEW & FILTER TICKETS ---
@app.get("/tickets/", response_model=List[TicketResponse])
def get_tickets(
    machine_id: Optional[str] = None,
    status: Optional[TicketStatus] = None,
    request_type: Optional[RequestType] = None
):
    """
    Allows operators to view all tickets or filter by machine ID, status, or type.
    """
    query = "SELECT * FROM tickets WHERE 1=1"
    params = []

    if machine_id:
        query += " AND machine_id = ?"
        params.append(machine_id)
    if status:
        query += " AND status = ?"
        params.append(status.value)
    if request_type:
        query += " AND request_type = ?"
        params.append(request_type.value)

    query += " ORDER BY created_at DESC"

    with sqlite3.connect(DB_NAME) as conn:
        conn.row_factory = sqlite3.Row
        cursor = conn.cursor()
        cursor.execute(query, params)
        rows = cursor.fetchall()

    return [dict(row) for row in rows]

# --- 4. OPERATOR UPDATE / CLOSE TICKET ---
@app.patch("/tickets/{ticket_id}", response_model=TicketResponse)
def update_ticket_status(ticket_id: int, update: TicketUpdate):
    """
    Allows the operator to update the ticket status (e.g., to 'in_progress' or 'closed')
    and add resolution notes (e.g., 'Refund issued via Venmo').
    """
    now = datetime.utcnow().isoformat()

    with sqlite3.connect(DB_NAME) as conn:
        conn.row_factory = sqlite3.Row
        cursor = conn.cursor()
        
        cursor.execute("SELECT * FROM tickets WHERE id = ?", (ticket_id,))
        existing = cursor.fetchone()
        if not existing:
            raise HTTPException(status_code=404, detail="Ticket not found")

        notes = update.operator_notes if update.operator_notes is not None else existing["operator_notes"]

        cursor.execute("""
            UPDATE tickets 
            SET status = ?, operator_notes = ?, updated_at = ?
            WHERE id = ?
        """, (update.status.value, notes, now, ticket_id))
        conn.commit()

        cursor.execute("SELECT * FROM tickets WHERE id = ?", (ticket_id,))
        updated_row = cursor.fetchone()

    return dict(updated_row)

